# ============================================================
# Application
# ============================================================
APP_NAME=multi-car-audio-processor
APP_VERSION=1.0.0
LOG_LEVEL=INFO

# ============================================================
# Cohere Arabic STT
# ============================================================
STT_MODEL_ID=CohereLabs/cohere-transcribe-arabic-07-2026
STT_MODEL_PATH=/app/models/cohere-transcribe-arabic-07-2026
STT_MAX_NEW_TOKENS=256

VAD_ENABLED=true
VAD_THRESHOLD=0.45
VAD_MIN_SPEECH_DURATION_MS=200
VAD_MIN_SILENCE_DURATION_MS=350
VAD_SPEECH_PAD_MS=120
VAD_MERGE_GAP_MS=900

HF_TOKEN=hfxxxxxx

# ============================================================
# Ollama / Qwen
# ============================================================
LLM_MODEL=qwen2.5:7b
LLM_TIMEOUT_SECONDS=600

# ============================================================
# Upload / audio
# ============================================================
MAX_UPLOAD_MB=200
AUDIO_SAMPLE_RATE=16000
